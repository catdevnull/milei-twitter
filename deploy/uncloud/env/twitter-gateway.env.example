# Paths, HOST and PORT are set in uncloud.yaml (data lives in the /data volume).
TWITTER_BROWSER_HEADLESS=1
TWITTER_ALLOW_DIRECT=1
ACCOUNT_MAX_ACTIVE_SESSIONS=1
ACCOUNT_CONCURRENCY=8
ACCOUNT_BOOTSTRAP_CONCURRENCY=1

# Optional proxy and rotation settings:
# PROXY_URL=
# WEBSHARE_PROXY_LIST_URL=
# ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000
