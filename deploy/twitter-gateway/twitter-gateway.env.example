PORT=3000
ACCOUNTS_FILE_PATH=/etc/twitter-gateway/accounts.txt
API_AUTH_FILE=/etc/twitter-gateway/api-users.txt
SQLITE_PATH=/var/lib/twitter-gateway/twitter-gateway.sqlite
PLAYWRIGHT_BROWSERS_PATH=/var/lib/twitter-gateway/ms-playwright
TWITTER_BROWSER_HEADLESS=1
TWITTER_ALLOW_DIRECT=1

# Optional proxy and rotation settings:
# PROXY_URL=
# WEBSHARE_PROXY_LIST_URL=
# ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000
