deploy:
	if [ -n "$(git status --porcelain)" ]; then echo "Error: There are unstaged changes. Please commit or stash them before deploying."; exit 1; fi

	env $(cat .env.production) pnpm db:migrate
	# Dokku may advance its branch with generated "Automated commit" commits.
	# Replace those only when the remote is still at the revision we fetched.
	git fetch dokku master
	git push --force-with-lease dokku master
